  "maturity_score_definition": {
    "form": "M = (1/(1+abs_net_over_sync)) * (1/(1+cross_seed_sd_over_sync)) * min(1, reac_over_diss) * (1.0 if lock_covered else 0.5)",
    "axes_used": [
      "abs_net_over_sync (A5 regime_aggregates + cw_sync_mean)",
      "cross_seed_sd_over_sync (A5 per_regime_class.rationale)",
      "reac_over_diss (A1 per_regime_aggregates cw_xi_reaction_mean / cw_dissipation_mean)",
      "lock_covered (A5 per_regime_class.axes.lock_covered)"
    ],
    "form_rationale": "Product form so that any near-zero factor collapses maturity (Liebig-minimum: the weakest axis gates the whole). Clamping reac_over_diss at 1 reflects that reactivity above balanced level does not further increase zero-mode maturity \u2014 only the match between reaction and dissipation matters for equilibrium."
